<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:QuailImageSearch.ViewModels"
        xmlns:views="using:QuailImageSearch.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
        x:Class="QuailImageSearch.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1200" Height="800"
        Title="Quail Image Search">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+T" Command="{Binding NewTabCommand}" />
        <KeyBinding Gesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding ToggleLogCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenPreferencesCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New tab" InputGesture="Ctrl+T" Command="{Binding NewTabCommand}" />
                <MenuItem Header="_Close tab" InputGesture="Ctrl+W" Command="{Binding CloseTabCommand}" />
                <Separator />
                <MenuItem Header="_Preferences…" InputGesture="Ctrl+OemComma" Command="{Binding OpenPreferencesCommand}" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Debug log" InputGesture="Ctrl+L" Command="{Binding ToggleLogCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Padding="8,2"
                Background="{DynamicResource AppPanelBrush}">
            <DockPanel>
                <ToggleButton DockPanel.Dock="Right" Content="Debug log" FontSize="12" Padding="8,2"
                              IsChecked="{Binding IsLogVisible}" ToolTip.Tip="Show searches, the commands that ran and the tools' raw output (Ctrl+L)" />
                <TextBlock Text="{Binding BackgroundStatus}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid x:Name="MainGrid" RowDefinitions="*,Auto,0">
            <!-- Debug log panel (row 2); its height is set in code-behind when toggled. -->
            <GridSplitter Grid.Row="1" Height="5" ResizeDirection="Rows" IsVisible="{Binding IsLogVisible}" />
            <DockPanel Grid.Row="2" IsVisible="{Binding IsLogVisible}">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="8,4">
                    <TextBlock Text="Debug log" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="Copy all" FontSize="12" Padding="8,2" Click="CopyLog_Click" />
                    <Button Content="Clear" FontSize="12" Padding="8,2" Command="{Binding ClearLogCommand}" />
                </StackPanel>
                <TextBox x:Name="LogBox" Text="{Binding Log.Text}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace"
                         FontSize="12" Margin="8,0,8,8"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
            </DockPanel>
            <Grid Grid.Row="0">
                <!-- The "+" button is placed right after the last tab in code-behind; tabs can be dragged to reorder. -->
                <TabControl x:Name="TabsControl" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}" Padding="0">
                    <TabControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- Room on the right so the "+" button always fits after the last tab. -->
                            <WrapPanel Margin="0,0,48,0" />
                        </ItemsPanelTemplate>
                    </TabControl.ItemsPanel>
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchTabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Header}" MaxWidth="220"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <Button Content="✕" Padding="4,0" FontSize="11" VerticalAlignment="Center"
                                        Background="Transparent" ToolTip.Tip="Close tab (Ctrl+W)"
                                        Command="{Binding $parent[TabControl].((vm:MainViewModel)DataContext).CloseTabCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="vm:SearchTabViewModel">
                            <views:SearchTabView />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
                <Button x:Name="NewTabButton" Content="+" ToolTip.Tip="New tab (Ctrl+T)" Command="{Binding NewTabCommand}"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0"
                        Padding="10,2" FontSize="16" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
