<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- DXGI adapter query (Services/Models/GpuInfo.cs) -->
    <Product>Quail Image Search</Product>
    <Version>1.0.0</Version>
    <!-- ISC license (see LICENSE at the repository root; the copyright holder is also named there). -->
    <Authors>Chase Grozdina</Authors>
    <Copyright>Copyright (c) 2026 Chase Grozdina</Copyright>
    <PackageLicenseExpression>ISC</PackageLicenseExpression>
    <!-- Program icon (Explorer, taskbar); windows get the same icon from App.axaml. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Windows builds (or publishing for a win-* runtime) use ONNX Runtime's DirectML package. -->
    <UseDirectML Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">true</UseDirectML>
    <UseDirectML Condition="$(RuntimeIdentifier.StartsWith('win'))">true</UseDirectML>
  </PropertyGroup>

  <ItemGroup>
    <!-- app.icns is for a future macOS app bundle, not needed at run time. -->
    <AvaloniaResource Include="Assets\**" Exclude="Assets\app.icns" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in list of downloadable models; see ModelCatalog. -->
    <EmbeddedResource Include="Services\Models\models.json" LogicalName="QuailImageSearch.Services.Models.models.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Calibration images (CC0/public domain, see Calibration/manifest.json), used to rescale scores to 0–100. -->
    <None Include="Calibration\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app's license and the third-party notices/licenses the bundled libraries require ship next to the program. -->
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\licenses\**" Link="licenses\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <!-- Used directly for decoding and rotating images; keep in step with the version Avalonia.Skia uses. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- ONNX Runtime: the DirectML build (GPU via DirectX 12, falls back to CPU) on Windows, the
         standard build (CPU, plus Core ML on macOS) elsewhere. Same version, so the same API. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" Condition="'$(UseDirectML)' == 'true'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" Condition="'$(UseDirectML)' != 'true'" />
  </ItemGroup>
</Project>
