<?xml version="1.0" encoding="utf-8"?>
<!-- Release build for win-x64, used by scripts/build.ps1 (which also passes -r win-x64 on the command line,
     so the project picks the right ONNX Runtime package). Self-contained: users don't need .NET installed. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Off for now: trimming can break reflection in Avalonia and the MVVM toolkit; a single file doesn't
         help because the calibration images and license files ship next to the program anyway. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Faster start-up but a ~30-50% bigger download; build.ps1 -ReadyToRun turns it on. -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- No debug symbols in releases. -->
    <DebugType>none</DebugType>
  </PropertyGroup>
</Project>
